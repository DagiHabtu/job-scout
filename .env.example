# Optional secrets. The system runs at $0 without any of these.
# Adzuna discovery (free key, ~1000 calls/month) — optional Mode-B discovery only.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional email digest via Gmail SMTP (requires 2FA + an app password). File digest needs none.
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
SMTP_TO=
